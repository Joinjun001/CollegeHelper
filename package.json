{
  "name": "college-helper",
  "version": "0.1.0",
  "private": true,
  "description": "A secure personal college helper powered by Canvas LMS and MCP",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --dir test",
    "check": "npm run typecheck && npm run lint && npm test",
    "audit": "node --env-file-if-exists=.env --import tsx scripts/audit-canvas-api.ts",
    "smoke:mcp": "node --import tsx scripts/smoke-mcp.ts",
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "start": "node --env-file-if-exists=.env dist/src/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "22.15.30",
    "eslint": "10.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
