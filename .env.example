# HY-ON Canvas 루트 주소입니다. /api/v1은 붙이지 않습니다.
CANVAS_BASE_URL=https://canvas.example.edu
# 실제 토큰은 이 예제 파일이나 Git에 절대 기록하지 않습니다.
CANVAS_ACCESS_TOKEN=replace-with-local-secret
CANVAS_REQUEST_TIMEOUT_MS=15000
AUDIT_MAX_PAGES=10
AUDIT_MAX_COURSES=3
REPORTS_DIR=reports
MCP_HOST=127.0.0.1
MCP_PORT=3000
LEARNING_RESOURCE_WORKER_URL=http://learning-resource-worker:3200
TZ=Asia/Seoul
